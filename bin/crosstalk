#!/bin/sh
# Runtime shim. crosstalk is TypeScript; this picks whichever JavaScript runtime
# the machine has and runs the prebuilt bundle, so installing the plugin never
# requires a toolchain.
#
#   crosstalk peers
#   crosstalk install goose
#   crosstalk daemon
#   crosstalk server
#   crosstalk hook
#   crosstalk relay
#
# Set CROSSTALK_RUNTIME to force one.

set -eu

# Resolve symlinks before working out where the plugin lives: `crosstalk` on
# PATH is a link into this directory, and $0 is then the link, not the target.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self=$target ;;
    *)  self=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)/$target ;;
  esac
done
here=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)

if [ $# -eq 0 ]; then
  echo "usage: crosstalk <command> [args...]   (try: crosstalk status)" >&2
  exit 64
fi
what=$1
shift

# Only these are real entry points. Everything else is a CLI subcommand, so
# `crosstalk install goose` and `crosstalk post "..."` work as written rather
# than needing a `cli` in front of them.
case "$what" in
  cli|daemon|server|hook|relay) ;;
  *) set -- "$what" "$@"; what=cli ;;
esac

runtime=""
forced=${CROSSTALK_RUNTIME-}
if [ -n "$forced" ]; then
  if command -v "$forced" >/dev/null 2>&1; then
    runtime=$forced
  else
    echo "crosstalk: CROSSTALK_RUNTIME is set to '$forced', which is not on PATH." >&2
    exit 127
  fi
else
  for candidate in bun node; do
    if command -v "$candidate" >/dev/null 2>&1; then
      runtime=$candidate
      break
    fi
  done
fi

if [ -z "$runtime" ]; then
  echo "crosstalk needs bun or node on PATH, and found neither." >&2
  echo "PATH is: $PATH" >&2
  echo "Install one: https://bun.sh or https://nodejs.org" >&2
  exit 127
fi

# Prefer the built bundle. Fall back to source when running from a checkout.
if [ -f "$here/dist/$what.js" ]; then
  exec "$runtime" "$here/dist/$what.js" "$@"
fi

case "$what" in
  relay) src="$here/relay/relay.ts" ;;
  *)     src="$here/src/$what.ts" ;;
esac

if [ ! -f "$src" ]; then
  echo "crosstalk: no dist/$what.js and no $src" >&2
  exit 66
fi

if [ "$runtime" != "bun" ]; then
  echo "crosstalk: dist/$what.js is missing and $runtime cannot run TypeScript." >&2
  echo "Run: bun scripts/build.ts" >&2
  exit 1
fi

exec "$runtime" "$src" "$@"
