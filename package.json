{
  "name": "crosstalk",
  "version": "0.1.40",
  "type": "module",
  "license": "MIT",
  "description": "Messaging between two people's Claude Code sessions",
  "repository": {
    "type": "git",
    "url": "https://github.com/epode-studio/crosstalk.git"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "daemon": "bun src/daemon.ts",
    "relay": "bun relay/relay.ts",
    "server": "bun src/server.ts",
    "crosstalk": "bun src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tools-doc": "bun scripts/tools-doc.ts",
    "test": "bash test/e2e.sh && bash test/resilience.sh && bun run test:routing && bun run test:restore && bun run test:gather && bun run test:ui && bun run test:channels && bun run test:repotrust && bun run test:terminal && bun run test:threads && bun run test:next && bun run test:shipping && bun run test:extras",
    "test:extras": "bun test test/extras.test.ts && bash test/extras.sh",
    "test:shipping": "bun test test/shipping.test.ts && bash test/shipping.sh",
    "test:repotrust": "bun test test/repotrust.test.ts && bash test/repotrust.sh",
    "test:gather": "bun test test/gather.test.ts && bash test/gather.sh",
    "test:channels": "bun test test/channels.test.ts && bash test/channels.sh",
    "test:ui": "bun test test/uistate.test.ts && bash test/ui.sh",
    "test:terminal": "bun test test/terminal.test.ts && bash test/terminal.sh",
    "test:threads": "bun test test/threads.test.ts && bash test/threads.sh",
    "test:next": "bun test test/next.test.ts && bash test/next.sh",
    "test:routing": "bun test test/footprint.test.ts && bash test/routing.sh",
    "test:restore": "bun test test/restore.test.ts && bash test/restore.sh",
    "test:nat": "bash test/docker/nat.sh",
    "test:tunnel": "bash test/tunnel.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@noble/curves": "^2.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
